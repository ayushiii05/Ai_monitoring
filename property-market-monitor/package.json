{
  "name": "property-market-monitor",
  "version": "1.0.0",
  "private": true,
  "description": "AI Property Market Monitor",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm --prefix backend start\" \"npm --prefix frontend run dev\"",
    "dev:backend": "npm --prefix backend start",
    "dev:frontend": "npm --prefix frontend run dev",
    "start": "npm --prefix backend start",
    "start:backend": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "test": "npm --prefix backend test",
    "test:backend": "npm --prefix backend test",
    "lint": "npm --prefix frontend run lint",
    "lint:frontend": "npm --prefix frontend run lint"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
